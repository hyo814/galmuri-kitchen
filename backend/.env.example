# 로컬 개발: 개발용 로그인 켜기 + 세션 쿠키 Secure 끄기. 운영에서는 절대 넣지 말 것.
DEV_MODE=1

# --- 필수 (운영 배포 시) ---
# SECRET_KEY=운영에서는 긴 랜덤 문자열 (예: python -c "import secrets; print(secrets.token_hex(32))")
# DATABASE_URL=비우면 backend/instance/dev.sqlite3. 운영은 Render PostgreSQL의 Internal Database URL

# --- 소셜 로그인 (docs/deploy.md 참고). 비워 두면 해당 버튼이 숨겨짐 ---
# KAKAO_CLIENT_ID=카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키의 REST API 키
# KAKAO_CLIENT_SECRET=카카오 개발자 콘솔 > 보안 > Client Secret
# GOOGLE_CLIENT_ID=Google Cloud Console > OAuth 클라이언트 ID
# GOOGLE_CLIENT_SECRET=Google Cloud Console > OAuth 클라이언트 보안 비밀

# --- AI 기능 (레시피 추천 등) ---
# ANTHROPIC_API_KEY=console.anthropic.com > API Keys
# CLAUDE_MODEL=claude-sonnet-5
# AI_DAILY_SCAN_LIMIT=10
# AI_DAILY_RECIPE_LIMIT=10

# --- 공공 데이터 API ---
# FOODSAFETY_API_KEY=식약처 공공데이터포털, 조리식품 레시피 API(COOKRCP01) 신청 키
# FOOD_NUTRITION_API_KEY=식약처 공공데이터포털, 식품영양성분 DB API 신청 키
# YOUTUBE_API_KEY=Google Cloud Console > YouTube Data API v3 키

# --- 네이버 쇼핑 검색 (가격 비교 등) ---
# NAVER_CLIENT_ID=네이버 개발자센터 > 애플리케이션 등록 > Client ID
# NAVER_CLIENT_SECRET=네이버 개발자센터 > 애플리케이션 등록 > Client Secret

# --- Cloudflare R2 (사진 저장) ---
# R2_ACCOUNT_ID=Cloudflare 대시보드 > R2 > 계정 ID
# R2_ACCESS_KEY_ID=Cloudflare 대시보드 > R2 > API 토큰 관리에서 발급
# R2_SECRET_ACCESS_KEY=위 토큰 발급 시 함께 발급되는 비밀 키
# R2_BUCKET=R2에서 생성한 버킷 이름

# 키가 비어 있으면 개발 모드에서는 샘플 데이터로 동작(각 기능 구현 시 적용), 운영에서는 해당 기능을 숨긴다.
