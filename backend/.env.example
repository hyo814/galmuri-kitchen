# =====================================================================
# 갈무리부엌 환경 변수 안내
#
# 이 파일(.env.example)은 git에 올라가는 "견본"이에요.
# 실제 값은 같은 폴더의 .env 파일에 넣으세요. .env는 git에 올라가지 않아요.
#
# 사용법
#   1. 필요한 줄의 맨 앞 "# "를 지우고, = 뒤에 발급받은 값을 붙여 넣어요.
#      예) ANTHROPIC_API_KEY=sk-ant-...
#   2. = 앞뒤에 띄어쓰기를 넣지 않아요. 따옴표도 넣지 않아요.
#   3. 저장한 뒤 개발 서버를 다시 켜면 적용돼요.
#   4. 키는 채팅, 스크린샷, 커밋에 절대 넣지 마세요.
#
# 키가 비어 있으면
#   - 개발 모드(DEV_MODE=1): 그 기능이 예시 데이터로 동작해요. 폰에서 흐름 확인은 가능해요.
#   - 운영: 그 기능이 화면에서 숨겨져요.
#
# 지금 당장 꼭 넣어야 하는 키는 없어요.
# 다만 [미리 신청] 표시가 있는 키는 승인이나 발급에 시간이 걸릴 수 있으니 먼저 신청해 두세요.
#
# 추천 순서
#   1) 식약처 조리식품 레시피 API   [미리 신청] 3단계 레시피
#   2) 식약처 식품영양성분 API      [미리 신청] 4b단계 영양
#   3) Claude API 키                2단계 사진 인식부터 (결제 수단 필요)
#   4) 네이버 검색 · YouTube 키     4 · 4b단계 (바로 발급)
#   5) Cloudflare R2 · 카카오/구글 로그인   배포할 때
# =====================================================================


# ---------------------------------------------------------------------
# 개발 모드
# ---------------------------------------------------------------------
# 개발용 로그인을 켜고, 세션 쿠키의 Secure를 꺼요. 운영(Render)에서는 절대 넣지 마세요.
DEV_MODE=1


# ---------------------------------------------------------------------
# 운영 필수 (배포할 때)
# ---------------------------------------------------------------------
# 세션 암호화 키. 운영에서는 긴 랜덤 문자열을 넣어요.
#   만드는 법: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# 비워 두면 backend/instance/dev.sqlite3을 써요.
# 운영에서는 Render PostgreSQL의 Internal Database URL을 넣어요.
# DATABASE_URL=


# ---------------------------------------------------------------------
# AI: 사진 인식(2단계) · AI 레시피(3단계)
# ---------------------------------------------------------------------
# [발급] https://console.anthropic.com
#   1. 가입하고 로그인해요.
#   2. Settings > Billing에서 결제 수단을 등록하고 크레딧을 충전해요.
#      크레딧이 없으면 키가 있어도 호출이 거절돼요.
#   3. Settings > API Keys > Create Key로 키를 만들어요.
#      키는 만들 때 한 번만 보여요. 바로 복사해 두세요.
#   4. 비용 관리: Settings > Limits에서 월 사용 한도를 걸어 두면 안심이에요.
# 키가 없으면 개발 모드에서 "예시 결과"로 사진 인식 흐름을 확인할 수 있어요.
# ANTHROPIC_API_KEY=

# 사용할 모델. 비워 두면 claude-sonnet-5
# CLAUDE_MODEL=claude-sonnet-5

# 사용자 한 명이 하루에 쓸 수 있는 횟수(실패한 호출은 세지 않아요). 비워 두면 10
# AI_DAILY_SCAN_LIMIT=10
# AI_DAILY_RECIPE_LIMIT=10


# ---------------------------------------------------------------------
# 식약처 공공 데이터
# ---------------------------------------------------------------------
# [미리 신청] 조리식품 레시피 DB (COOKRCP01) — 3단계 레시피
#   발급처: 식품안전나라 https://www.foodsafetykorea.go.kr
#   1. 회원가입 후 로그인해요.
#   2. 공공데이터 활용서비스 > 인증키 신청으로 가요.
#   3. 활용 목적에 "개인 프로젝트 레시피 추천 앱"처럼 적고 신청해요.
#   4. 승인되면 마이페이지(인증키 발급 현황)에서 키를 확인해요.
#   5. 같은 키로 "조리식품의 레시피 DB(COOKRCP01)"를 호출해요.
# FOODSAFETY_API_KEY=

# [미리 신청] 식품영양성분 DB — 4b단계 칼로리·당류 계산
#   발급처: 공공데이터포털 https://www.data.go.kr
#   1. 회원가입 후 로그인해요.
#   2. "식품영양성분" 검색 > 식품의약품안전처 제공 오픈 API > 활용신청을 눌러요.
#   3. 승인되면 마이페이지 > 데이터활용 > 오픈API에서 "일반 인증키(Decoding)"를 복사해요.
#      Encoding 키가 아니라 Decoding 키를 넣어요.
#   참고: 승인 직후에는 키가 동작하기까지 몇 시간 걸리기도 해요.
# FOOD_NUTRITION_API_KEY=


# ---------------------------------------------------------------------
# 유튜브 인기 레시피 — 4b단계 식단
# ---------------------------------------------------------------------
# [발급] Google Cloud Console https://console.cloud.google.com
#   1. 프로젝트를 만들어요(카카오/구글 로그인과 같은 프로젝트를 써도 돼요).
#   2. API 및 서비스 > 라이브러리에서 "YouTube Data API v3"를 찾아 사용 설정해요.
#   3. 사용자 인증 정보 > 사용자 인증 정보 만들기 > API 키를 선택해요.
#   4. 만든 키의 "API 제한"에서 YouTube Data API v3만 허용하면 안전해요.
# YOUTUBE_API_KEY=


# ---------------------------------------------------------------------
# 네이버 쇼핑 검색(최저가) — 4단계 장보기
# ---------------------------------------------------------------------
# [발급] 네이버 개발자센터 https://developers.naver.com
#   1. Application > 애플리케이션 등록으로 가요.
#   2. 사용 API에서 "검색"을 골라요.
#   3. 비로그인 오픈 API 서비스 환경은 WEB 설정, 주소는 http://localhost 로 넣어요(배포 후 도메인 추가).
#   4. 등록하면 Client ID와 Client Secret이 보여요.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=


# ---------------------------------------------------------------------
# 사진 저장소 Cloudflare R2 — 5단계 조리 기록 사진 (배포할 때)
# ---------------------------------------------------------------------
# 비워 두면 backend/uploads/ 폴더에 저장해요. 로컬에서는 이대로 충분해요.
# [발급] Cloudflare 대시보드 https://dash.cloudflare.com
#   1. R2를 켜고 버킷을 하나 만들어요(비공개 그대로).
#   2. R2 > API 토큰 관리 > 토큰 생성에서 "개체 읽기 및 쓰기" 권한을 줘요.
#   3. 생성 화면에 나오는 Access Key ID와 Secret Access Key를 복사해요(한 번만 보여요).
#   4. 계정 ID는 R2 개요 화면 오른쪽에 있어요.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=


# ---------------------------------------------------------------------
# 소셜 로그인 (배포할 때) — 자세한 절차는 docs/deploy.md
# ---------------------------------------------------------------------
# 비워 두면 해당 로그인 버튼이 숨겨져요.
# 로그인 콜백 주소에 배포 도메인이 필요해서, Render 주소가 정해진 뒤에 등록해요.
#   카카오: https://developers.kakao.com > 내 애플리케이션
#     - 앱 키 > REST API 키 → KAKAO_CLIENT_ID
#     - 보안 > Client Secret → KAKAO_CLIENT_SECRET
#     - Redirect URI: https://<배포 도메인>/auth/callback/kakao
#   구글: https://console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹)
#     - 승인된 리디렉션 URI: https://<배포 도메인>/auth/callback/google
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
