# =====================================================================
# 갈무리부엌 환경 변수 안내
#
# 이 파일(.env.example)은 git에 올라가는 "견본"이에요.
# 실제 값은 같은 폴더의 .env 파일에 넣어주세요. .env는 git에 올라가지 않아요.
#
# 사용법
#   1. 필요한 줄의 맨 앞 "# "를 지우고, = 뒤에 발급받은 값을 붙여 넣어요.
#      예) ANTHROPIC_API_KEY=sk-ant-...
#   2. = 앞뒤에 띄어쓰기를 넣지 않아요. 따옴표도 넣지 않아요.
#   3. 저장한 뒤 개발 서버를 다시 켜면 적용돼요.
#
# 꼭 지켜주세요
#   - 키는 채팅, 스크린샷, 커밋에 절대 넣지 않아요. 새어 나갔다면 발급한 곳에서 바로 지우고 새로 만들어요.
#   - .env는 git에 올라가지 않아요. 이 견본에는 진짜 값을 적지 않아요.
#   - 운영(Render)은 .env를 쓰지 않아요. Render 대시보드 > 웹 서비스 > Environment에
#     아래와 같은 이름으로 넣고 다시 배포해요(Manual Deploy > Deploy latest commit).
#   - DEV_MODE는 운영에 절대 넣지 않아요. 넣으면 Render에서 앱이 시작을 거부해요.
#
# 키가 비어 있으면
#   - 개발 모드(DEV_MODE=1): 그 기능이 예시 데이터로 동작해요. 폰에서 흐름 확인은 가능해요.
#   - 운영: 그 기능이 화면에서 숨겨져요. 단 R2가 비면 숨기지 않고, 사진을 올릴 때 "사진을 지금은 올릴 수 없어요."(503) 안내가 나와요.
# =====================================================================


# =====================================================================
# 배포 전에 넣을 값 체크리스트 (해커톤 2026-09-20 기준, 필요한 순서)
# =====================================================================
# [ ] ① Claude API 키 (ANTHROPIC_API_KEY)
#       없으면: 사진으로 재고 넣기(영수증·냉장고·장보기 메모), AI 레시피, 레시피 링크 가져오기를 운영에서 쓸 수 없어요(버튼이 숨겨지거나 막혀요).
#       결제 수단 등록 + 크레딧 충전이 필요해요. Settings > Limits에서 월 한도(예: $20)를 꼭 걸어주세요.
# [ ] ② Cloudflare R2 네 값 (R2_ACCOUNT_ID · R2_ACCESS_KEY_ID · R2_SECRET_ACCESS_KEY · R2_BUCKET)
#       없으면: 운영에서 장보기 메모 사진 올리기·보기가 "사진을 지금은 올릴 수 없어요."로 막혀요.
#       네 값 중 하나라도 비면 연결하지 않아요.
# [ ] ③ DEMO_LOGIN=1 (운영에서만)
#       없으면: 로그인 화면에 "로그인 없이 체험하기"가 안 보여요. 심사위원이 소셜 로그인을 거쳐야 해요.
# [ ] ④ 카카오 로그인 (KAKAO_CLIENT_ID · KAKAO_CLIENT_SECRET)
#       없으면: 카카오 로그인 버튼이 숨겨져요. Render 배포 주소가 정해진 뒤 Redirect URI를 등록해요.
# [ ] ⑤ SECRET_KEY · DATABASE_URL (Render)
#       없으면: SECRET_KEY가 없으면 운영에서 앱이 아예 시작하지 않아요.
#       DATABASE_URL이 없으면 컨테이너 안 SQLite를 써서 배포할 때마다 데이터가 지워져요.
# [ ] ⑥ 선택
#       - YOUTUBE_API_KEY: 없으면 요리 채널 영상 칸이 숨겨지고 유튜브 링크 가져오기가 안 돼요.
#       - FOODSAFETY_API_KEY: 없으면 식약처 공공 레시피를 받지 못해요(대신 flask seed-sample-recipes로 예시 레시피).
#       - FOOD_NUTRITION_API_KEY: 없으면 레시피·식단 영양 계산이 숨겨져요.
#       - COUPANG_ACCESS_KEY · COUPANG_SECRET_KEY: 둘 다 없으면 일반 쿠팡 검색 링크이고 "광고" 표시도 없어요.
# =====================================================================


# ---------------------------------------------------------------------
# 개발 모드 (로컬 전용)
# ---------------------------------------------------------------------
# 개발용 로그인을 켜고, 세션 쿠키의 Secure를 꺼요. 운영(Render)에서는 절대 넣지 않아요.
DEV_MODE=1


# ---------------------------------------------------------------------
# ⑤ 운영 필수 — SECRET_KEY · DATABASE_URL
# ---------------------------------------------------------------------
# 세션 암호화 키. 운영에서는 긴 랜덤 문자열을 넣어요. 로컬 값을 다시 쓰지 않아요.
#   만드는 법: python -c "import secrets; print(secrets.token_hex(32))"
#   Render에서는 Environment의 Generate 버튼으로 만들어도 돼요.
#   체험 계정 IP 해시에도 이 값을 써요. 지우기 Cron Job에도 같은 값을 넣어요(docs/deploy.md 5-3).
# SECRET_KEY=

# 비워 두면 backend/instance/dev.sqlite3을 써요.
# 운영에서는 Render PostgreSQL(Region: Singapore)을 만들고 Internal Database URL을 넣어요.
# DATABASE_URL=


# ---------------------------------------------------------------------
# ① Claude API — 사진으로 재고 넣기 · AI 레시피 · 레시피 링크 가져오기
# ---------------------------------------------------------------------
# [발급] https://console.anthropic.com
#   1. 가입하고 로그인해요.
#   2. Settings > Billing에서 결제 수단을 등록하고 크레딧을 충전해요.
#      크레딧이 없으면 키가 있어도 호출이 거절돼요.
#   3. Settings > Limits에서 월 사용 한도를 꼭 걸어주세요(예: $20). 한도를 넘으면 호출이 멈춰서 요금이 더 나가지 않아요.
#   4. Settings > API Keys > Create Key로 키를 만들어요.
#      키는 만들 때 한 번만 보여요. 바로 복사해 두세요.
# 키가 없으면 개발 모드에서 "예시 결과"로 흐름을 확인할 수 있어요.
# ANTHROPIC_API_KEY=

# 사용할 모델. 비워 두면 claude-sonnet-5
# CLAUDE_MODEL=claude-sonnet-5

# 사용자 한 명이 하루(서울 날짜)에 쓸 수 있는 횟수(AI로 보낸 호출은 성공·실패 관계없이 세요). 비워 두면 10
# AI_DAILY_SCAN_LIMIT=10
# AI_DAILY_RECIPE_LIMIT=10

# 60초 안에 사진 인식·AI 레시피를 이 횟수 이상 보내면 잠시 막아요(짧은 연속 호출 남용 방지). 비워 두면 3
# AI_SCAN_BURST_LIMIT=3


# ---------------------------------------------------------------------
# ② 사진 저장소 Cloudflare R2 — 장보기 메모 사진
# ---------------------------------------------------------------------
# 비워 두면 개발 모드에서는 backend/uploads/ 폴더에 저장해요. 로컬에서는 이대로 충분해요.
# 운영에서 비워 두면 사진 올리기·보기가 막혀요(Render 디스크는 배포할 때 지워져서 로컬에 두지 않아요).
# 사진은 앱 서버를 거쳐 보여줘요. 그래서 버킷을 공개하거나 CORS를 열 필요가 없어요.
#
# [발급] Cloudflare 대시보드 https://dash.cloudflare.com
#   1. Cloudflare에 가입하고 로그인해요.
#   2. 왼쪽 메뉴 R2 개체 저장소(R2 Object Storage)에서 R2를 켜요.
#      결제 수단 등록을 요구할 수 있어요. 저장 10GB/월까지는 무료라 이 앱 규모에서는 요금이 나오지 않아요.
#   3. 버킷 만들기(Create bucket)를 눌러요.
#      이름은 영어 소문자로 정해요(예: galmuri-photos). 위치는 자동, 공개 설정은 건드리지 않고 비공개 그대로 둬요.
#      이 이름이 R2_BUCKET이에요.
#   4. R2 개요 화면의 API 토큰 관리(Manage R2 API Tokens) > API 토큰 생성을 눌러요.
#      - 권한: "개체 읽기 및 쓰기"(Object Read & Write)
#      - 적용 대상: "특정 버킷에만 적용"을 고르고 3번에서 만든 버킷 하나만 선택해요.
#      - TTL은 그대로 두고 만들어요.
#   5. 만든 뒤 나오는 화면에서 값을 복사해요. Secret은 이 화면에서 한 번만 보여요.
#      - 액세스 키 ID(Access Key ID)      → R2_ACCESS_KEY_ID
#      - 비밀 액세스 키(Secret Access Key) → R2_SECRET_ACCESS_KEY
#      - 계정 ID(Account ID)는 R2 개요 화면 오른쪽에 있어요 → R2_ACCOUNT_ID
#        (S3 주소 https://<계정 ID>.r2.cloudflarestorage.com의 앞부분과 같아요. 주소 전체가 아니라 ID만 넣어요.)
#   6. 아래 네 줄에 넣어요. 네 값이 모두 있어야 R2를 써요.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=


# ---------------------------------------------------------------------
# ③ 체험하기 계정 — 심사·둘러보기용 (운영에서만)
# ---------------------------------------------------------------------
# 1이면 로그인 화면에 "로그인 없이 체험하기"가 보여요. 누를 때마다 예시 재고가 든 새 계정을 만들고 24시간 뒤 지워요.
# DEV_MODE와 상관없이 운영에서 켤 수 있어요. 끄려면 변수를 지워요. 로컬에서는 개발용 로그인이 있어 안 넣어도 돼요.
# 한 시간마다 지우는 Cron Job 설정은 docs/deploy.md 5-3을 봐주세요.
# DEMO_LOGIN=1

# 같은 IP(IPv6는 /64)에서 만들 수 있는 체험 계정 수 — 1시간 한도 · 24시간 한도.
# 사무실·행사장 와이파이처럼 여러 사람이 주소 하나를 같이 쓰면 이 한도를 함께 나눠 써요. 비워 두면 30 · 100
# DEMO_IP_HOURLY_LIMIT=30
# DEMO_IP_DAILY_LIMIT=100

# 체험 계정 전체가 24시간 동안 쓸 수 있는 사진 인식·AI 레시피 호출 수. 넘으면 체험 계정은 AI를 부르지 않고 예시 결과를 보여줘요.
# Claude 요금이 걱정되면 줄여요. 비워 두면 300
# DEMO_AI_GLOBAL_DAILY=300

# 앞단 프록시가 몇 겹인지(X-Forwarded-For를 붙이는 수). 체험하기 IP 한도가 이 값으로 접속한 사람 주소를 골라요.
# Render는 1이라 비워 두면 돼요. 배포 뒤 한 번 확인하는 방법은 docs/deploy.md 5-3에 있어요.
# TRUSTED_PROXY_HOPS=1


# ---------------------------------------------------------------------
# ④ 소셜 로그인 — 자세한 절차는 docs/deploy.md 4·5·5-1
# ---------------------------------------------------------------------
# 비워 두면 해당 로그인 버튼이 숨겨져요.
# 콜백 주소에 배포 도메인이 필요해서, Render 주소(https://<서비스명>.onrender.com)가 정해진 뒤에 등록해요.
#
# 카카오 (해커톤에서는 이것 하나면 충분해요): https://developers.kakao.com > 내 애플리케이션 > 애플리케이션 추가
#   1. 앱 키 > REST API 키 → KAKAO_CLIENT_ID
#   2. 플랫폼 > Web > 사이트 도메인에 https://<배포 도메인> 등록
#   3. 카카오 로그인 > 활성화 ON > Redirect URI에 https://<배포 도메인>/auth/callback/kakao 등록
#   4. 동의항목 > 닉네임 설정
#   5. 보안 > Client Secret 코드 생성, 활성화 → KAKAO_CLIENT_SECRET
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
#
# 네이버: https://developers.naver.com > Application > 애플리케이션 등록(네이버 로그인, 제공 정보 별명)
#   - Client ID → NAVER_CLIENT_ID, Client Secret → NAVER_CLIENT_SECRET
#   - Callback URL: https://<배포 도메인>/auth/callback/naver
#   - 등록 직후는 "개발 중"이라 멤버로 넣은 계정만 로그인돼요. 한 번 발급한 앱은 바꾸지 않아요.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
#
# 구글: https://console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹)
#   - 승인된 리디렉션 URI: https://<배포 도메인>/auth/callback/google
#   - "프로덕션 게시" 전에는 테스트 사용자로 넣은 계정만 로그인돼요.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# ---------------------------------------------------------------------
# ⑥ 선택 — 유튜브 요리 채널 영상 · 유튜브 링크 가져오기
# ---------------------------------------------------------------------
# 없으면 개발 모드는 예시 영상, 운영은 영상 칸이 숨겨져요. 체험 계정은 키가 있어도 늘 예시 영상이에요.
# [발급] Google Cloud Console https://console.cloud.google.com
#   1. 프로젝트를 만들어요(구글 로그인과 같은 프로젝트를 써도 돼요).
#   2. API 및 서비스 > 라이브러리에서 "YouTube Data API v3"를 찾아 사용 설정해요.
#   3. 사용자 인증 정보 > 사용자 인증 정보 만들기 > API 키를 선택해요.
#   4. 만든 키의 "API 제한사항"에서 YouTube Data API v3만 허용해요.
#   무료 한도는 하루 10,000 units이고, 앱이 하루 8,000 units 안에서 멈춰요.
# YOUTUBE_API_KEY=


# ---------------------------------------------------------------------
# ⑥ 선택 — 식약처 공공 데이터
# ---------------------------------------------------------------------
# [미리 신청] 조리식품 레시피 DB (COOKRCP01) — 레시피 추천
#   메뉴 이름이 사이트에서 "데이터활용서비스"로 되어 있어 찾기 어려워요. 아래 주소로 바로 들어가세요.
#   1. 식품안전나라 데이터활용서비스: https://www.foodsafetykorea.go.kr/api/main.do
#      오른쪽 위에서 로그인해요(식품안전나라 회원가입 필요).
#   2. 같은 화면 메뉴의 "인증키 신청"을 눌러 신청해요. 활용 목적은 "개인 프로젝트 레시피 추천 앱"처럼 적어요.
#      인증키는 계정당 1개만 발급돼요. 이 키 하나로 식품안전나라의 여러 API를 함께 써요.
#   3. 발급된 키는 같은 사이트의 인증키 발급 현황(마이페이지)에서 확인해요.
#   4. 키를 넣고 배포한 뒤 Render Shell에서 한 번 flask sync-public-recipes를 실행해요.
#      키가 없으면 flask seed-sample-recipes로 예시 레시피를 넣어요.
#   API 설명 페이지(샘플 확인용):
#      https://www.foodsafetykorea.go.kr/api/openApiInfo.do?menu_grp=MENU_GRP31&menu_no=661&show_cnt=10&start_idx=1&svc_no=COOKRCP01
#   막히면 고객지원센터 1899-5590
# FOODSAFETY_API_KEY=

# 식품영양성분 DB — 4b-2 레시피·식단 영양 계산(공공데이터포털 "식품의약품안전처_식품영양성분DB정보")
#   1. https://www.data.go.kr 회원가입 후 로그인해요.
#   2. "식품영양성분" 검색 > 식품의약품안전처 제공 오픈 API > 활용신청을 눌러요.
#   3. 승인되면 마이페이지 > 데이터활용 > 오픈API에서 "일반 인증키(Decoding)"를 복사해요.
#      Encoding 키가 아니라 Decoding 키를 넣어요. 승인 직후에는 동작하기까지 몇 시간 걸리기도 해요.
#   없으면 개발 모드는 예시 식품으로, 운영은 영양 칸을 숨겨요.
# FOOD_NUTRITION_API_KEY=


# ---------------------------------------------------------------------
# ⑥ 선택 — 쿠팡 파트너스
# ---------------------------------------------------------------------
# 장보기 "쇼핑몰에서 찾기"의 쿠팡 링크를 파트너스 링크로 바꿔요(서버가 딥링크 API로 만들어요, backend/app/coupang.py).
# Access Key와 Secret Key가 둘 다 있을 때만 쿠팡 이름 옆에 "광고"와 파트너스 안내 문구가 보여요.
# 하나라도 비면 지금처럼 일반 쿠팡 검색 링크이고 화면이 바뀌지 않아요.
# API가 실패하거나 3초 안에 답하지 않거나 1시간 호출 한도(앱 전체 80번·사용자당 10번)를 넘으면 그 순간만 일반 링크로 열어요.
# [발급] 쿠팡 파트너스 https://partners.coupang.com
#   1. 로그인해요. 최종 승인이 끝난 계정이어야 API Key 발급 버튼이 켜져요.
#   2. 파트너스 API 메뉴(이용 가이드의 "파트너스 API")에서 API Key를 발급해요.
#   3. 나오는 Access Key와 Secret Key를 아래 두 칸에 넣어요. Secret Key는 다른 곳에 올리지 않아요.
#   4. 계정 관리 > 활동 채널에 앱 주소(Render 주소)를 웹사이트로 등록해요. 등록하지 않은 채널의 실적은 인정되지 않을 수 있어요.
# [Render] 웹 서비스 Environment에 같은 이름 COUPANG_ACCESS_KEY · COUPANG_SECRET_KEY로 넣어요(Cron에는 필요 없어요).
# COUPANG_ACCESS_KEY=
# COUPANG_SECRET_KEY=
#
# 트래킹 코드(AF로 시작)는 참고용이에요. 링크는 위 두 키로 만들어서 비워 둬도 돼요.
# COUPANG_PARTNERS_ID=
